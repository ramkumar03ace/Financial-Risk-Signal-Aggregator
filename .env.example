# Copy this file to .env and paste your free Gemini API key.
# Get a key (no billing required) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: override the default model.
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Optional second LLM provider, selectable in the app's sidebar dropdown.
# NVIDIA NIM is OpenAI-compatible and offers free prototype endpoints.
#
# How to get a NVIDIA key:
#   1. Go to https://build.nvidia.com/models
#   2. Sign in or create an NVIDIA Developer account.
#   3. Open a text/chat model, for example openai/gpt-oss-20b.
#   4. Click "Generate API Key" or "Get API Key" and copy the nvapi-... key.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# NVIDIA_API_KEY=your_nvapi_key_here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=openai/gpt-oss-20b
#
# Advanced: for non-NVIDIA OpenAI-compatible providers, OPENAI_API_KEY is also
# accepted instead of NVIDIA_API_KEY.
