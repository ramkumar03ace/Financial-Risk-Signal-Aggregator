# Copy this file to .env and paste your free Gemini API key.
# Get a key (no billing required) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: override the default model.
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Optional second LLM provider, selectable in the app's sidebar dropdown.
# Any OpenAI-compatible API works here — NVIDIA NIM (free), OpenAI, Groq, etc.
# Default base URL below points at NVIDIA's free catalog.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.3-70b-instruct